            calculateGuestTotal() {
                const rows = document.querySelectorAll('#guest-items-list > div');
                let itemsSubtotal = 0;

                rows.forEach(row => {
                    const price = parseFloat(row.querySelector('.item-price-input').value) || 0;
                    const qty = parseInt(row.querySelector('.item-qty-input').value) || 1;
                    itemsSubtotal += price * qty;
                });

                const count = Math.max((this.sessionData.participants || []).length, 1);
                const deliveryTotal = this.sessionData.deliveryFee || 0;
                const splitMethod = this.sessionData.splitMethod || 'equal';
                const taxType = this.sessionData.taxType || 'fixed';
                const serviceVal = this.sessionData.serviceFee || 0;

                let deliveryShare = 0;
                let taxShare = 0;

                if (splitMethod === 'proportional') {
                    const currentBreakdowns = this.computeBreakdowns();
                    const groupSub = currentBreakdowns.groupSubtotal + itemsSubtotal;
                    
                    if (groupSub > 0) {
                        const ratio = itemsSubtotal / groupSub;
                        deliveryShare = ratio * deliveryTotal;
                        
                        const totalTaxEgp = (taxType === 'percent') ? (groupSub * serviceVal) / 100 : serviceVal;
                        taxShare = ratio * totalTaxEgp;
                    }
                } else {
                    deliveryShare = deliveryTotal / count;
                    if (taxType === 'percent') {
                        const totalTaxEgp = ((this.computeBreakdowns().groupSubtotal + itemsSubtotal) * serviceVal) / 100;
                        taxShare = totalTaxEgp / count;
                    } else {
                        taxShare = serviceVal / count;
                    }
                }

                const grandTotal = itemsSubtotal + deliveryShare + taxShare;

                document.getElementById('calc-guest-subtotal').innerText = itemsSubtotal.toFixed(2) + ' EGP';
                document.getElementById('calc-guest-delivery-share').innerText = deliveryShare.toFixed(2) + ' EGP';
                document.getElementById('calc-guest-tax-share').innerText = taxShare.toFixed(2) + ' EGP';
                document.getElementById('calc-guest-tax-mode-label').innerText = taxType === 'percent' ? `${serviceVal}%` : 'Fixed';
                document.getElementById('calc-guest-split-info').innerText = `Split Mode: ${splitMethod === 'proportional' ? 'Proportional by subtotal' : 'Equal per participant'}`;
                document.getElementById('calc-guest-grandtotal').innerText = grandTotal.toFixed(2) + ' EGP';
            }

            checkExistingColleagueName() {
                const nameInput = document.getElementById('guest-name-input').value.trim().toLowerCase();
                const btnText = document.getElementById('guest-submit-btn-text');
                const editingIndicator = document.getElementById('guest-editing-indicator');

                if (!nameInput) {
                    btnText.innerText = 'Submit Order to Group';
                    editingIndicator.classList.add('hidden');
                    return;
                }

                const existingOrder = (this.sessionData.participants || []).find(p => p.name.toLowerCase() === nameInput || (p.token && p.token === this.userToken));

                if (existingOrder) {
                    btnText.innerText = 'Save / Update Order';
                    editingIndicator.classList.remove('hidden');
                } else {
                    btnText.innerText = 'Submit Order to Group';
                    editingIndicator.classList.add('hidden');
                }
            }

            async submitGuestOrder() {
                if (this.sessionData.isLocked) {
                    this.showToast('Orders are locked by the admin', 'error');
                    return;
                }

                const nameInput = document.getElementById('guest-name-input').value.trim();
                if (!nameInput) {
                    this.showToast('Please enter your name', 'error');
                    return;
                }

                const rows = document.querySelectorAll('#guest-items-list > div');
                const submittedItems = [];

                rows.forEach(row => {
                    const name = row.querySelector('.item-name-input').value.trim();
                    const price = parseFloat(row.querySelector('.item-price-input').value) || 0;
                    const qty = parseInt(row.querySelector('.item-qty-input').value) || 1;

                    if (name && price >= 0) {
                        submittedItems.push({ name, price, qty });
                    }
                });

                if (submittedItems.length === 0) {
                    this.showToast('Please add at least one item name and price', 'error');
                    return;
                }

                const participants = [...(this.sessionData.participants || [])];
                
                // Find by token or name
                let existingIndex = -1;
                if (this.userToken) {
                    existingIndex = participants.findIndex(p => p.token === this.userToken || p.id === this.userToken);
                }
                if (existingIndex < 0) {
                    existingIndex = participants.findIndex(p => p.name.toLowerCase() === nameInput.toLowerCase());
                }

                let currentToken = this.userToken || 'tok_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 6);

                if (existingIndex >= 0) {
                    participants[existingIndex].name = nameInput;
                    participants[existingIndex].items = submittedItems;
                    participants[existingIndex].token = participants[existingIndex].token || currentToken;
                    currentToken = participants[existingIndex].token;
                    this.showToast('Your order has been updated successfully!', 'success');
                } else {
                    participants.push({
                        id: 'part_' + Date.now().toString(36),
                        token: currentToken,
                        name: nameInput,
                        items: submittedItems,
                        isPaid: false
                    });
                    this.showToast('Order submitted successfully!', 'success');
                }

                this.userToken = currentToken;
                this.sessionData.participants = participants;
                await this.saveSessionData();

                const personalUrl = this.generateUniqueShareURL('guest', currentToken);
                document.getElementById('personal-link-input').value = personalUrl;

                this.checkExistingColleagueName();
            }

