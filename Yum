    <!-- Firebase Async Import Guard Module -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, deleteDoc, onSnapshot, collection, getDocs } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        let db = null;
        let auth = null;
        let appId = typeof __app_id !== 'undefined' ? __app_id : 'food-order-app';

        try {
            if (typeof __firebase_config !== 'undefined' && __firebase_config) {
                const firebaseConfig = JSON.parse(__firebase_config);
                const fbApp = initializeApp(firebaseConfig);
                db = getFirestore(fbApp);
                auth = getAuth(fbApp);

                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    signInWithCustomToken(auth, __initial_auth_token).catch(() => signInAnonymously(auth));
                } else {
                    signInAnonymously(auth).catch(() => {});
                }
            }
        } catch (e) {
            console.log("Operating in Zero-Config Dynamic State Payload Mode");
        }

        window.firebaseStore = { db, auth, appId, doc, setDoc, deleteDoc, onSnapshot, collection, getDocs };
    </script>

    <!-- Core Application Logic -->
    <script>
        class FoodOrderApp {
            constructor() {
                this.sessionId = null;
                this.userToken = null; // Unique personal token for colleagues
                this.mode = 'landing'; // 'landing', 'guest', 'admin'
                this.broadcastChannel = null;
                this.fbUnsubscribe = null;
                this.isGuestInFullEditMode = false;

                this.sessionData = {
                    restaurantName: '',
                    adminName: '',
                    menuUrl: '',
                    menuImage: null,
                    deliveryFee: 0,
                    serviceFee: 0,
                    taxType: 'fixed', // 'fixed' or 'percent'
                    splitMethod: 'equal', // 'equal' or 'proportional'
                    isLocked: false,
                    createdAt: null,
                    presets: [],
                    participants: []
                };

                this.initBroadcastChannel();
                window.addEventListener('hashchange', () => this.handleRouting());
                window.addEventListener('storage', (e) => this.handleStorageEvent(e));
                
                document.addEventListener('DOMContentLoaded', () => {
                    lucide.createIcons();
                    this.handleRouting();
                });
            }

            initBroadcastChannel() {
                try {
                    this.broadcastChannel = new BroadcastChannel('food_order_sync');
                    this.broadcastChannel.onmessage = (event) => {
                        if (event.data && event.data.sessionId === this.sessionId) {
                            this.sessionData = event.data.sessionData;
                            this.renderCurrentView();
                        }
                    };
                } catch (e) {
                    console.log("BroadcastChannel unavailable");
                }
            }

            handleStorageEvent(e) {
                if (e.key === `food_session_${this.sessionId}` && e.newValue) {
                    try {
                        this.sessionData = JSON.parse(e.newValue);
                        this.renderCurrentView();
                    } catch (err) {}
                }
            }

            // -------------------------------------------------------------
            // DYNAMIC UNIQUE SHARE LINK GENERATOR
            // -------------------------------------------------------------
            generateUniqueShareURL(mode = 'guest', token = null) {
                const uniqueShareToken = 'share_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 6);
                
                const payload = encodeURIComponent(JSON.stringify({
                    r: this.sessionData.restaurantName,
                    a: this.sessionData.adminName,
                    u: this.sessionData.menuUrl,
                    d: this.sessionData.deliveryFee,
                    s: this.sessionData.serviceFee,
                    t: this.sessionData.taxType,
                    m: this.sessionData.splitMethod,
                    l: this.sessionData.isLocked,
                    st: uniqueShareToken
                }));

                let url = `${window.location.origin}${window.location.pathname}#session=${this.sessionId}&mode=${mode}&share_token=${uniqueShareToken}&state=${payload}`;
                if (token) {
                    url += `&token=${token}`;
                }
                return url;
            }

            generateAndCopyFreshGuestLink() {
                const url = this.generateUniqueShareURL('guest');
                this.fallbackCopyText(url);
                this.showToast('Generated fresh unique share link!', 'success');
            }

            generateAndCopyPersonalLink() {
                let currentToken = this.userToken;
                if (!currentToken) {
                    currentToken = 'tok_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 6);
                    this.userToken = currentToken;
                }

                const url = this.generateUniqueShareURL('guest', currentToken);
                document.getElementById('personal-link-input').value = url;
                this.fallbackCopyText(url);
                this.showToast('Generated & copied personal edit link!', 'success');
            }

            // -------------------------------------------------------------
            // SESSION CREATION & STATE ENCODING
            // -------------------------------------------------------------
            async handleCreateSession(event) {
                if (event) event.preventDefault();
                
                const submitBtn = document.getElementById('btn-submit-create');
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerText = 'Creating Session...';
                }

                try {
                    const restName = document.getElementById('create-restaurant-name').value.trim();
                    const adminName = document.getElementById('create-admin-name').value.trim();
                    const menuUrl = document.getElementById('create-menu-url').value.trim();
                    const deliveryFee = parseFloat(document.getElementById('create-delivery-fee').value) || 0;
                    const serviceFee = parseFloat(document.getElementById('create-service-fee').value) || 0;
                    const fileInput = document.getElementById('create-menu-file');

                    let menuImageData = null;
                    if (fileInput && fileInput.files && fileInput.files[0]) {
                        menuImageData = await this.readFileAsBase64(fileInput.files[0]);
                    }

                    this.sessionId = 'sess_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 6);

                    this.sessionData = {
                        restaurantName: restName,
                        adminName: adminName,
                        menuUrl: menuUrl,
                        menuImage: menuImageData,
                        deliveryFee: deliveryFee,
                        serviceFee: serviceFee,
                        taxType: 'fixed',
                        splitMethod: 'equal',
                        isLocked: false,
                        createdAt: new Date().toISOString(),
                        presets: [],
                        participants: []
                    };

                    this.saveSessionToLocalStorage();
                    this.syncToFirebase().catch(() => {});

                    this.closeModal('modal-create-session');
                    this.updateURLHash('admin');
                    this.showToast('Live Group Order created successfully!', 'success');

                } catch (err) {
                    console.error('Session creation error:', err);
                    this.showToast('Failed to create session. Please try again.', 'error');
                } finally {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = `<i data-lucide="plus-circle" class="w-4 h-4"></i><span>Create Live Session</span>`;
                        lucide.createIcons();
                    }
                }
            }

            updateURLHash(viewMode, token = null) {
                const url = this.generateUniqueShareURL(viewMode, token);
                window.location.href = url;
            }

            async saveSessionData() {
                this.saveSessionToLocalStorage();

                if (this.broadcastChannel) {
                    this.broadcastChannel.postMessage({
                        sessionId: this.sessionId,
                        sessionData: this.sessionData
                    });
                }

                await this.syncToFirebase();
            }

            saveSessionToLocalStorage() {
                try {
                    localStorage.setItem(`food_session_${this.sessionId}`, JSON.stringify(this.sessionData));
                    
                    const history = JSON.parse(localStorage.getItem('food_sessions_archive') || '[]');
                    const existingIdx = history.findIndex(h => h.id === this.sessionId);
                    const historyEntry = { id: this.sessionId, ...this.sessionData };

                    if (existingIdx >= 0) {
                        history[existingIdx] = historyEntry;
                    } else {
                        history.unshift(historyEntry);
                    }

                    localStorage.setItem('food_sessions_archive', JSON.stringify(history.slice(0, 30)));
                } catch (e) {}
            }

            async syncToFirebase() {
                if (window.firebaseStore && window.firebaseStore.db) {
                    try {
                        const { db, appId, doc, setDoc } = window.firebaseStore;
                        const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'food_sessions', this.sessionId);
                        await setDoc(docRef, this.sessionData, { merge: true });
                    } catch (e) {}
                }
            }

            loadSessionState(sessionId, statePayload) {
                if (statePayload) {
                    try {
                        const decoded = JSON.parse(decodeURIComponent(statePayload));
                        this.sessionData.restaurantName = decoded.r || this.sessionData.restaurantName;
                        this.sessionData.adminName = decoded.a || this.sessionData.adminName;
                        this.sessionData.menuUrl = decoded.u || this.sessionData.menuUrl;
                        this.sessionData.deliveryFee = decoded.d || 0;
                        this.sessionData.serviceFee = decoded.s || 0;
                        this.sessionData.taxType = decoded.t || 'fixed';
                        this.sessionData.splitMethod = decoded.m || 'equal';
                        this.sessionData.isLocked = !!decoded.l;
                    } catch (e) {}
                }

                const localData = localStorage.getItem(`food_session_${sessionId}`);
                if (localData) {
                    try {
                        this.sessionData = JSON.parse(localData);
                    } catch (e) {}
                }

                if (window.firebaseStore && window.firebaseStore.db) {
                    try {
                        const { db, appId, doc, onSnapshot } = window.firebaseStore;
                        const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'food_sessions', sessionId);
                        
                        if (this.fbUnsubscribe) this.fbUnsubscribe();
                        this.fbUnsubscribe = onSnapshot(docRef, (snap) => {
                            if (snap.exists()) {
                                this.sessionData = snap.data();
                                this.saveSessionToLocalStorage();
                                this.renderCurrentView();
                            }
                        }, () => {});
                    } catch (e) {}
                }
            }

            // -------------------------------------------------------------
            // ROUTING & VIEW SWITCHING
            // -------------------------------------------------------------
            handleRouting() {
                const hash = window.location.hash.substring(1);
                const params = new URLSearchParams(hash);
                const sessId = params.get('session');
                const viewMode = params.get('mode');
                const statePayload = params.get('state');
                const token = params.get('token');

                if (sessId) {
                    this.sessionId = sessId;
                    this.userToken = token || null;
                    this.mode = (viewMode === 'admin') ? 'admin' : 'guest';
                    this.loadSessionState(this.sessionId, statePayload);
                    this.renderCurrentView();
                } else {
                    this.showLandingView();
                }
            }

            goHome() {
                window.location.hash = '';
                this.showLandingView();
            }

            showLandingView() {
                this.mode = 'landing';
                document.getElementById('view-landing').classList.remove('hidden');
                document.getElementById('view-participant').classList.add('hidden');
                document.getElementById('view-admin').classList.add('hidden');
            }

            renderCurrentView() {
                if (this.mode === 'admin') {
                    this.renderAdminView();
                } else if (this.mode === 'guest') {
                    this.renderParticipantView();
                }
            }

            // -------------------------------------------------------------
            // TAX & DELIVERY BREAKDOWN CALCULATIONS ENGINE
            // -------------------------------------------------------------
            computeBreakdowns() {
                const participants = this.sessionData.participants || [];
                const count = participants.length;
                const deliveryTotal = this.sessionData.deliveryFee || 0;
                const splitMethod = this.sessionData.splitMethod || 'equal';
                const taxType = this.sessionData.taxType || 'fixed';
                const serviceVal = this.sessionData.serviceFee || 0;

                let groupSubtotal = 0;
                const listWithSubtotals = participants.map(p => {
                    const subtotal = (p.items || []).reduce((s, item) => s + ((parseFloat(item.price) || 0) * (parseInt(item.qty) || 1)), 0);
                    groupSubtotal += subtotal;
                    return { ...p, subtotal };
                });

                let totalTaxEgp = 0;
                if (taxType === 'percent') {
                    totalTaxEgp = (groupSubtotal * serviceVal) / 100;
                } else {
                    totalTaxEgp = serviceVal;
                }

                const calculatedParticipants = listWithSubtotals.map(p => {
                    let deliveryShare = 0;
                    let taxShare = 0;

                    if (splitMethod === 'proportional') {
                        if (groupSubtotal > 0) {
                            const ratio = p.subtotal / groupSubtotal;
                            deliveryShare = ratio * deliveryTotal;
                            taxShare = ratio * totalTaxEgp;
                        } else {
                            deliveryShare = count > 0 ? deliveryTotal / count : 0;
                            taxShare = count > 0 ? totalTaxEgp / count : 0;
                        }
                    } else {
                        deliveryShare = count > 0 ? deliveryTotal / count : 0;
                        taxShare = count > 0 ? totalTaxEgp / count : 0;
                    }

                    const grandTotal = p.subtotal + deliveryShare + taxShare;
                    return { ...p, deliveryShare, taxShare, grandTotal };
                });

                const grandTotalBill = groupSubtotal + deliveryTotal + totalTaxEgp;

                return {
                    groupSubtotal,
                    deliveryTotal,
                    totalTaxEgp,
                    grandTotalBill,
                    participants: calculatedParticipants,
                    count
                };
            }

            // -------------------------------------------------------------
            // PARTICIPANT / GUEST VIEW & EDITING LOGIC
            // -------------------------------------------------------------
            renderParticipantView() {
                document.getElementById('view-landing').classList.add('hidden');
                document.getElementById('view-admin').classList.add('hidden');
                document.getElementById('view-participant').classList.remove('hidden');

                document.getElementById('guest-restaurant-name').innerText = this.sessionData.restaurantName || 'Restaurant Order';
                document.getElementById('guest-session-admin').innerText = `Organized by ${this.sessionData.adminName || 'Admin'}`;

                const statusEl = document.getElementById('guest-lock-status');
                if (this.sessionData.isLocked) {
                    statusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-rose-500"></span> Orders Locked`;
                    statusEl.className = 'text-xs font-bold text-rose-600 flex items-center gap-1';
                    document.getElementById('guest-submit-btn').disabled = true;
                    document.getElementById('guest-submit-btn').classList.add('opacity-50', 'cursor-not-allowed');
                } else {
                    statusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Live & Open`;
                    statusEl.className = 'text-xs font-bold text-emerald-600 flex items-center gap-1';
                    document.getElementById('guest-submit-btn').disabled = false;
                    document.getElementById('guest-submit-btn').classList.remove('opacity-50', 'cursor-not-allowed');
                }

                const linkBtn = document.getElementById('guest-menu-link-btn');
                if (this.sessionData.menuUrl) {
                    linkBtn.href = this.sessionData.menuUrl;
                    linkBtn.classList.remove('hidden');
                } else {
                    linkBtn.classList.add('hidden');
                }

                const imgBtn = document.getElementById('guest-menu-img-btn');
                if (this.sessionData.menuImage) {
                    imgBtn.classList.remove('hidden');
                } else {
                    imgBtn.classList.add('hidden');
                }

                this.renderGuestPresets();

                // Setup personal edit link input
                const personalInput = document.getElementById('personal-link-input');
                personalInput.value = this.generateUniqueShareURL('guest', this.userToken || 'tok_' + Math.random().toString(36).substring(2, 8));

                if (this.userToken) {
                    this.loadParticipantByToken(this.userToken);
                } else {
                    const container = document.getElementById('guest-items-list');
                    if (container.children.length === 0) {
                        this.addGuestItemRow();
                    }
                }

                this.checkExistingColleagueName();
