<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>What Are We Going to Eat? — yumara</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        yumara: {
                            50: '#f6f8f2',
                            100: '#e7efe0',
                            200: '#d1e0c3',
                            300: '#b0cb9b',
                            400: '#8a9e6e',
                            500: '#6c824e',
                            600: '#4a5d33', // Primary Olive Green
                            700: '#3b4b27',
                            800: '#2d381f',
                            900: '#232d19',
                        },
                        cream: {
                            50: '#faf9f5',
                            100: '#f8f6f0', // Canvas background from logo
                            200: '#f3efe6',
                            300: '#e8e2d4',
                            400: '#d7cdb9',
                            500: '#c2b39b',
                        },
                        forest: {
                            800: '#2d3524',
                            900: '#1b2216',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8f6f0;
            color: #2d3524;
        }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f3efe6; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #d7cdb9; border-radius: 9999px; }
    </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-yumara-600 selection:text-white">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col space-y-2 pointer-events-none"></div>

    <!-- Header Navigation -->
    <header class="bg-white/90 backdrop-blur-md border-b border-cream-300 sticky top-0 z-30 shadow-sm">
        <div class="max-w-5xl mx-auto px-4 sm:px-6">
            <div class="flex justify-between items-center h-16">
                <!-- Yumara Logo & Title -->
                <div class="flex items-center space-x-3 cursor-pointer" onclick="app.goHome()">
                    <div class="flex items-center gap-2 text-yumara-600">
                        <svg class="h-8 w-auto fill-current" viewBox="0 0 320 100" xmlns="http://www.w3.org/2000/svg">
                            <!-- Cloche Dome -->
                            <path d="M 15 52 A 28 28 0 0 1 71 52 Z M 10 55 L 76 55 A 3 3 0 0 1 76 61 L 10 61 A 3 3 0 0 1 10 55 Z" />
                            <!-- Fork -->
                            <path d="M 83 23 L 83 40 C 83 46 99 46 99 40 L 99 23 L 95 23 L 95 36 L 93 36 L 93 23 L 89 23 L 89 36 L 87 36 L 87 23 Z M 89 44 L 93 44 L 93 68 L 89 68 Z" />
                            <!-- Knife -->
                            <path d="M 103 23 C 111 23 112 38 111 46 L 103 46 Z M 105 48 L 109 48 L 109 68 L 105 68 Z" />
                            <!-- Seasoning Dots -->
                            <circle cx="73" cy="69" r="3" />
                            <circle cx="82" cy="74" r="2.5" />
                            <circle cx="94" cy="71" r="2" />
                            <circle cx="98" cy="76" r="2.5" />
                            <!-- 'yumara' Text -->
                            <text x="120" y="65" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="46" letter-spacing="-1">yumara</text>
                        </svg>
                    </div>
                </div>

                <!-- Navigation Controls -->
                <div class="flex items-center space-x-2">
                    <button onclick="app.openHistoryModal()" class="inline-flex items-center space-x-1.5 px-3 py-1.5 text-xs font-semibold text-yumara-800 bg-cream-200 hover:bg-cream-300 rounded-lg transition-colors border border-cream-300">
                        <i data-lucide="history" class="w-4 h-4"></i>
                        <span class="hidden sm:inline">Order History</span>
                    </button>
                    <button onclick="app.showCreateSessionModal()" class="inline-flex items-center space-x-1.5 px-3.5 py-1.5 text-xs font-bold text-white bg-yumara-600 hover:bg-yumara-700 rounded-lg shadow-sm transition-colors">
                        <i data-lucide="plus-circle" class="w-4 h-4"></i>
                        <span class="hidden sm:inline">New Group Order</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-6">

        <!-- VIEW 1: LANDING PAGE -->
        <div id="view-landing" class="hidden flex flex-col items-center justify-center py-12 text-center max-w-xl mx-auto">
            <div class="w-24 h-24 bg-yumara-100 rounded-3xl flex items-center justify-center text-yumara-600 mb-6 shadow-inner border border-yumara-200">
                <svg class="h-12 w-auto fill-current" viewBox="0 0 120 80">
                    <path d="M 15 52 A 28 28 0 0 1 71 52 Z M 10 55 L 76 55 A 3 3 0 0 1 76 61 L 10 61 A 3 3 0 0 1 10 55 Z" />
                    <path d="M 83 23 L 83 40 C 83 46 99 46 99 40 L 99 23 L 95 23 L 95 36 L 93 36 L 93 23 L 89 23 L 89 36 L 87 36 L 87 23 Z M 89 44 L 93 44 L 93 68 L 89 68 Z" />
                    <path d="M 103 23 C 111 23 112 38 111 46 L 103 46 Z M 105 48 L 109 48 L 109 68 L 105 68 Z" />
                </svg>
            </div>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-forest-800 mb-2 tracking-tight">What Are We Going to Eat?</h2>
            <p class="text-yumara-600 text-xs font-bold uppercase tracking-widest mb-4">Powered by yumara</p>
            <p class="text-slate-600 mb-8 leading-relaxed text-sm sm:text-base">
                Coordinate group food orders seamlessly. Generate unique links for your colleagues, allow everyone to keep a personal edit link, and calculate delivery & tax shares automatically in <strong>EGP (ج.م)</strong>!
            </p>
            <div class="flex flex-col sm:flex-row gap-3">
                <button onclick="app.showCreateSessionModal()" class="inline-flex justify-center items-center space-x-2 px-6 py-3 text-sm font-bold text-white bg-yumara-600 hover:bg-yumara-700 rounded-xl shadow-lg shadow-yumara-600/20 transition-all transform hover:-translate-y-0.5">
                    <i data-lucide="plus-circle" class="w-5 h-5"></i>
                    <span>Start New Group Order</span>
                </button>
                <button onclick="app.openHistoryModal()" class="inline-flex justify-center items-center space-x-2 px-6 py-3 text-sm font-bold text-forest-800 bg-white border border-cream-300 hover:bg-cream-100 rounded-xl shadow-sm transition-all">
                    <i data-lucide="history" class="w-5 h-5"></i>
                    <span>View Order History</span>
                </button>
            </div>
        </div>

        <!-- VIEW 2: PARTICIPANT / GUEST VIEW -->
        <div id="view-participant" class="hidden max-w-xl mx-auto space-y-6">
            
            <!-- Participant Header & Restaurant Info -->
            <div class="bg-white rounded-2xl p-5 sm:p-6 border border-cream-300 shadow-sm relative overflow-hidden space-y-4">
                <div class="flex items-center justify-between">
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-yumara-100 text-yumara-800 border border-yumara-200">
                        COLLEAGUE ORDER FORM
                    </span>
                    <span id="guest-lock-status" class="text-xs font-bold text-emerald-600 flex items-center gap-1">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Live & Open
                    </span>
                </div>

                <div>
                    <h2 id="guest-restaurant-name" class="text-2xl font-extrabold text-forest-800 tracking-tight">Restaurant Name</h2>
                    <p id="guest-session-admin" class="text-xs text-slate-500 mt-0.5">Organized by Admin</p>
                </div>

                <!-- Menu Links / Image Attachments -->
                <div class="flex flex-wrap gap-2 pt-1">
                    <a id="guest-menu-link-btn" href="#" target="_blank" class="hidden inline-flex items-center space-x-1.5 px-3 py-1.5 text-xs font-bold text-yumara-700 bg-yumara-50 hover:bg-yumara-100 rounded-xl border border-yumara-200">
                        <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                        <span>View Online Menu</span>
                    </a>
                    <button id="guest-menu-img-btn" onclick="app.openMenuImageModal()" class="hidden inline-flex items-center space-x-1.5 px-3 py-1.5 text-xs font-bold text-forest-800 bg-cream-200 hover:bg-cream-300 rounded-xl border border-cream-300">
                        <i data-lucide="image" class="w-3.5 h-3.5"></i>
                        <span>View Uploaded Menu Image</span>
                    </button>
                </div>

                <!-- Personal Link Notification Card -->
                <div id="personal-link-card" class="p-4 bg-yumara-50 border border-yumara-300 rounded-2xl space-y-2">
                    <div class="flex items-start justify-between">
                        <div class="flex items-center space-x-2">
                            <div class="w-7 h-7 rounded-lg bg-yumara-600 text-white flex items-center justify-center shrink-0">
                                <i data-lucide="link-2" class="w-4 h-4"></i>
                            </div>
                            <div>
                                <h4 class="font-extrabold text-xs text-forest-800">Your Personal Edit Link</h4>
                                <p class="text-[11px] text-slate-600">Save or copy this unique link to edit your order anytime!</p>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center space-x-2 pt-1">
                        <input type="text" id="personal-link-input" readonly class="w-full text-xs px-3 py-1.5 rounded-lg border border-yumara-200 bg-white font-mono text-slate-600 select-all">
                        <button onclick="app.generateAndCopyPersonalLink()" class="px-3 py-1.5 bg-yumara-600 hover:bg-yumara-700 text-white text-xs font-bold rounded-lg shrink-0 shadow-sm flex items-center space-x-1">
                            <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
                            <span>Generate & Copy</span>
                        </button>
                    </div>
                </div>

                <!-- Input: Name -->
                <div class="pt-2 border-t border-cream-200 space-y-1">
                    <label class="block text-xs font-bold text-forest-800 uppercase tracking-wider">1. Your Name *</label>
                    <input type="text" id="guest-name-input" placeholder="e.g. Ahmed, Sarah..." oninput="app.checkExistingColleagueName()" class="w-full text-sm px-3.5 py-2.5 rounded-xl border border-cream-300 bg-cream-50 focus:outline-none focus:ring-2 focus:ring-yumara-500/20 focus:border-yumara-600 font-semibold text-forest-800">
                </div>

                <!-- Presets Quick Bar -->
                <div id="guest-presets-wrapper" class="hidden space-y-1.5">
                    <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider">Quick Add Menu Presets</label>
                    <div id="guest-presets-list" class="flex flex-wrap gap-1.5"></div>
                </div>

                <!-- Items Input Rows -->
                <div class="space-y-3 pt-2 border-t border-cream-200">
                    <div class="flex justify-between items-center">
                        <label class="block text-xs font-bold text-forest-800 uppercase tracking-wider">2. Your Order Items & Prices (EGP) *</label>
                        <span id="guest-editing-indicator" class="hidden text-[11px] font-bold text-yumara-700 bg-yumara-100 px-2 py-0.5 rounded-md">
                            Editing Your Order
                        </span>
                    </div>
                    
                    <div id="guest-items-list" class="space-y-2.5"></div>

                    <button type="button" onclick="app.addGuestItemRow()" class="w-full py-2 px-3 border border-dashed border-yumara-300 hover:border-yumara-600 hover:bg-yumara-50 text-yumara-700 text-xs font-bold rounded-xl flex items-center justify-center space-x-1.5 transition-all">
                        <i data-lucide="plus" class="w-4 h-4"></i>
                        <span>Add Another Item</span>
                    </button>
                </div>

                <!-- Automatic Real-time Breakdown -->
                <div class="bg-forest-800 text-white rounded-2xl p-4 space-y-2 text-xs shadow-md">
                    <div class="flex justify-between text-cream-200">
                        <span>Items Subtotal:</span>
                        <span id="calc-guest-subtotal" class="font-bold text-white">0.00 EGP</span>
                    </div>
                    <div class="flex justify-between text-cream-200">
                        <span>Delivery Fee Share:</span>
                        <span id="calc-guest-delivery-share" class="font-bold text-white">0.00 EGP</span>
                    </div>
                    <div class="flex justify-between text-cream-200">
                        <span>Tax Share (<span id="calc-guest-tax-mode-label">Fixed</span>):</span>
                        <span id="calc-guest-tax-share" class="font-bold text-white">0.00 EGP</span>
                    </div>
                    <div class="text-[10px] text-yumara-200 italic pt-1" id="calc-guest-split-info">
                        Split Mode: Equal per participant
                    </div>
                    <div class="pt-2 border-t border-forest-900/60 flex justify-between items-baseline text-sm">
                        <span class="font-bold text-yumara-300">Total Amount Due:</span>
                        <span id="calc-guest-grandtotal" class="text-lg font-extrabold text-yumara-300">0.00 EGP</span>
                    </div>
                </div>

                <!-- Submit / Update Button -->
                <button id="guest-submit-btn" onclick="app.submitGuestOrder()" class="w-full py-3 bg-yumara-600 hover:bg-yumara-700 text-white font-bold text-sm rounded-xl shadow-lg shadow-yumara-600/20 transition-all flex items-center justify-center space-x-2">
                    <i data-lucide="check-circle-2" class="w-5 h-5"></i>
                    <span id="guest-submit-btn-text">Submit Order to Group</span>
                </button>
            </div>
        </div>

        <!-- VIEW 3: ADMIN CONTROL VIEW -->
        <div id="view-admin" class="hidden space-y-6">

            <!-- Admin Banner -->
            <div class="bg-white rounded-2xl p-5 sm:p-6 border border-cream-300 shadow-sm relative overflow-hidden">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <div class="flex items-center space-x-3 mb-1">
                            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-yumara-100 text-yumara-800 border border-yumara-200">
                                ADMIN DASHBOARD
                            </span>
                            <span id="admin-status-badge" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200 flex items-center gap-1">
                                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Live & Open
                            </span>
                        </div>
                        <h2 id="admin-restaurant-name" class="text-2xl font-extrabold text-forest-800 tracking-tight">Restaurant Name</h2>
                        <p id="admin-session-date" class="text-xs text-slate-500 mt-1">Today</p>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex flex-wrap items-center gap-2">
                        <button onclick="app.generateAndCopyFreshGuestLink()" class="inline-flex items-center space-x-2 px-3.5 py-2 text-xs font-bold text-white bg-yumara-600 hover:bg-yumara-700 rounded-xl shadow-sm transition-all">
                            <i data-lucide="share-2" class="w-4 h-4"></i>
                            <span>Generate Unique Share Link</span>
                        </button>
                        <button onclick="app.copyWhatsAppSummary()" class="inline-flex items-center space-x-2 px-3.5 py-2 text-xs font-bold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 rounded-xl border border-emerald-200 transition-colors">
                            <i data-lucide="message-square" class="w-4 h-4"></i>
                            <span>WhatsApp Summary</span>
                        </button>
                        <button id="admin-lock-btn" onclick="app.toggleLockSession()" class="inline-flex items-center space-x-2 px-3.5 py-2 text-xs font-bold text-forest-800 bg-cream-200 hover:bg-cream-300 rounded-xl border border-cream-300 transition-colors">
                            <i data-lucide="lock" class="w-4 h-4"></i>
                            <span id="admin-lock-btn-text">Lock Orders</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Admin Grid: Orders Stream & Fee Calculations -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

                <!-- Col 1: Submitted Colleague Orders Stream (col-span-7) -->
                <div class="lg:col-span-7 space-y-4">
                    <div class="bg-white rounded-2xl p-5 sm:p-6 border border-cream-300 shadow-sm space-y-4">
                        <div class="flex items-center justify-between border-b border-cream-200 pb-3">
                            <div class="flex items-center space-x-2">
                                <i data-lucide="users" class="w-5 h-5 text-yumara-600"></i>
                                <h3 class="font-bold text-forest-800 text-base">Live Team Orders Stream</h3>
                            </div>
                            <div class="flex items-center space-x-2">
                                <button onclick="app.openAdminEditModal()" class="inline-flex items-center space-x-1.5 px-3 py-1.5 text-xs font-bold text-yumara-700 bg-yumara-50 hover:bg-yumara-100 rounded-lg border border-yumara-200 transition-colors">
                                    <i data-lucide="user-plus" class="w-3.5 h-3.5"></i>
                                    <span>Add Colleague Order</span>
                                </button>
                                <span id="admin-participant-count" class="text-xs font-bold bg-cream-200 px-2.5 py-1 rounded-full text-forest-800 border border-cream-300">
                                    0 Orders
                                </span>
                            </div>
                        </div>

                        <div id="admin-participants-list" class="space-y-4 divide-y divide-cream-200"></div>
                    </div>
                </div>

                <!-- Col 2: Settings & Financial Breakdown (col-span-5) -->
                <div class="lg:col-span-5 space-y-6">

                    <!-- Delivery & Tax Controls -->
                    <div class="bg-white rounded-2xl p-5 sm:p-6 border border-cream-300 shadow-sm space-y-4">
                        <div class="flex items-center space-x-2 border-b border-cream-200 pb-3">
                            <i data-lucide="receipt" class="w-5 h-5 text-yumara-600"></i>
                            <h3 class="font-bold text-forest-800 text-base">Taxes & Delivery Splitting</h3>
                        </div>

                        <div class="space-y-3">
                            <div>
                                <label class="block text-xs font-bold text-forest-800 mb-1">Total Delivery Fee (EGP)</label>
                                <input type="number" id="admin-delivery-fee" min="0" step="0.5" placeholder="0.00" onchange="app.updateFeesFromAdmin()" oninput="app.updateFeesFromAdmin()" class="w-full text-sm px-3.5 py-2 rounded-xl border border-cream-300 bg-cream-50 font-semibold text-forest-800">
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-forest-800 mb-1">Tax / Service Charge Type</label>
                                <div class="grid grid-cols-2 gap-2 mb-2">
                                    <button type="button" id="tax-type-fixed" onclick="app.setTaxType('fixed')" class="py-1.5 text-xs font-bold rounded-lg border border-yumara-600 bg-yumara-50 text-yumara-700">Fixed Amount (EGP)</button>
                                    <button type="button" id="tax-type-percent" onclick="app.setTaxType('percent')" class="py-1.5 text-xs font-bold rounded-lg border border-cream-300 bg-cream-100 text-forest-800">Percentage (%)</button>
                                </div>
                                <input type="number" id="admin-service-fee" min="0" step="0.1" placeholder="0" onchange="app.updateFeesFromAdmin()" oninput="app.updateFeesFromAdmin()" class="w-full text-sm px-3.5 py-2 rounded-xl border border-cream-300 bg-cream-50 font-semibold text-forest-800">
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-forest-800 mb-1">Fee & Tax Calculation Mode</label>
                                <select id="admin-split-method" onchange="app.updateFeesFromAdmin()" class="w-full text-sm px-3.5 py-2 rounded-xl border border-cream-300 bg-cream-50 font-semibold text-forest-800">
                                    <option value="equal">Equal Split (Divided equally per person)</option>
                                    <option value="proportional">Proportional Split (Based on subtotal amount)</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Grand Total Summary -->
                    <div class="bg-forest-800 text-white rounded-2xl p-5 sm:p-6 shadow-xl space-y-4 border border-forest-900">
                        <div class="flex items-center justify-between border-b border-forest-900/60 pb-3">
                            <h3 class="font-bold text-base text-yumara-300">Total Group Summary</h3>
                            <span class="text-xs bg-forest-900 text-yumara-200 px-2.5 py-0.5 rounded-full font-semibold">EGP / ج.م</span>
                        </div>

                        <div class="space-y-2 text-xs text-cream-200">
                            <div class="flex justify-between">
                                <span>Food Items Subtotal:</span>
                                <span id="admin-summary-subtotal" class="font-bold text-white">0.00 EGP</span>
                            </div>
                            <div class="flex justify-between">
                                <span>Delivery Fee:</span>
                                <span id="admin-summary-delivery" class="font-bold text-white">0.00 EGP</span>
                            </div>
                            <div class="flex justify-between">
                                <span>Total Tax / Service:</span>
                                <span id="admin-summary-service" class="font-bold text-white">0.00 EGP</span>
                            </div>
                            <div class="pt-2 border-t border-forest-900/60 flex justify-between items-baseline text-sm">
                                <span class="font-bold text-white">Grand Total Bill:</span>
                                <span id="admin-summary-grandtotal" class="text-xl font-extrabold text-yumara-300">0.00 EGP</span>
                            </div>
                        </div>
                    </div>

                    <!-- Preset Items Manager -->
                    <div class="bg-white rounded-2xl p-5 border border-cream-300 shadow-sm space-y-3">
                        <h4 class="font-bold text-forest-800 text-sm">Preset Menu Items</h4>
                        <p class="text-xs text-slate-500">Add preset items for quick colleague selection.</p>
                        <button onclick="app.openAdminMenuModal()" class="w-full py-2.5 px-4 bg-cream-200 hover:bg-cream-300 text-forest-800 font-bold text-xs rounded-xl flex items-center justify-center space-x-2 border border-cream-300">
                            <i data-lucide="settings" class="w-4 h-4"></i>
                            <span>Manage Presets</span>
                        </button>
                    </div>

                </div>

            </div>

        </div>

    </main>

    <!-- MODAL: CREATE SESSION -->
    <div id="modal-create-session" class="fixed inset-0 bg-forest-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-cream-300 space-y-4 max-h-[90vh] overflow-y-auto custom-scrollbar">
            <div class="flex justify-between items-center border-b border-cream-200 pb-3">
                <h3 class="font-extrabold text-forest-800 text-lg">Start New Group Order</h3>
                <button onclick="app.closeModal('modal-create-session')" class="text-slate-400 hover:text-slate-600">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <form id="create-session-form" onsubmit="app.handleCreateSession(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-forest-800 uppercase tracking-wider mb-1">Restaurant Name *</label>
                    <input type="text" id="create-restaurant-name" required placeholder="e.g. Zooba, Kebdet El Prince, McDonald's..." class="w-full text-sm px-3.5 py-2.5 rounded-xl border border-cream-300 bg-cream-50 focus:outline-none focus:ring-2 focus:ring-yumara-500/20 focus:border-yumara-600 font-medium text-forest-800">
                </div>

                <div>
                    <label class="block text-xs font-bold text-forest-800 uppercase tracking-wider mb-1">Admin / Organizer Name *</label>
