                                <p class="text-[11px] font-bold text-yumara-700 mt-0.5">${grandTotal.toFixed(2)} EGP (${parts.length} Participants) • Split: ${item.splitMethod || 'equal'}</p>
                            </div>
                            <div class="flex items-center space-x-2">
                                <button onclick="app.loadHistoricalSession('${item.id}')" class="px-3 py-1.5 bg-yumara-600 hover:bg-yumara-700 text-white text-xs font-bold rounded-lg shadow-sm">
                                    Open
                                </button>
                                <button onclick="app.deleteHistoricalSession('${item.id}')" class="p-1.5 text-rose-600 hover:bg-rose-100 rounded-lg transition-colors" title="Delete Session">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </div>
                    `;
                }).join('');

                lucide.createIcons();
            }

            async deleteHistoricalSession(id) {
                if (!confirm('Are you sure you want to delete this old session from history?')) return;

                let history = [];
                try {
                    history = JSON.parse(localStorage.getItem('food_sessions_archive') || '[]');
                } catch (e) {}

                history = history.filter(item => item.id !== id);
                localStorage.setItem('food_sessions_archive', JSON.stringify(history));
                localStorage.removeItem(`food_session_${id}`);

                if (window.firebaseStore && window.firebaseStore.db) {
                    try {
                        const { db, appId, doc, deleteDoc } = window.firebaseStore;
                        const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'food_sessions', id);
                        await deleteDoc(docRef);
                    } catch (e) {}
                }

                this.showToast('Session deleted', 'info');
                this.renderHistoryList();
            }

            async clearAllHistory() {
                if (!confirm('Are you sure you want to clear ALL past order history? This cannot be undone.')) return;

                let history = [];
                try {
                    history = JSON.parse(localStorage.getItem('food_sessions_archive') || '[]');
                } catch (e) {}

                history.forEach(item => {
                    localStorage.removeItem(`food_session_${item.id}`);
                });

                localStorage.removeItem('food_sessions_archive');
                this.showToast('All past session history cleared', 'info');
                this.renderHistoryList();
            }

            loadHistoricalSession(id) {
                this.closeModal('modal-history');
                this.sessionId = id;
                this.loadSessionState(id);
                this.updateURLHash('admin');
            }

            // -------------------------------------------------------------
            // SHARING & UTILS
            // -------------------------------------------------------------
            fallbackCopyText(text) {
                if (navigator.clipboard) {
                    navigator.clipboard.writeText(text).then(() => {
                        this.showToast('Copied to clipboard!', 'success');
                    }).catch(() => this.execCopyCommand(text));
                } else {
                    this.execCopyCommand(text);
                }
            }

            execCopyCommand(text) {
                const textArea = document.createElement("textarea");
                textArea.value = text;
                document.body.appendChild(textArea);
                textArea.select();
                try {
                    document.execCommand('copy');
                    this.showToast('Copied to clipboard!', 'success');
                } catch (err) {
                    this.showToast('Could not copy automatically', 'error');
                }
                document.body.removeChild(textArea);
            }

            copyWhatsAppSummary() {
                const breakdown = this.computeBreakdowns();
                const restName = this.sessionData.restaurantName || 'Food Order';

                let text = `🍱 *yumara* — *What Are We Going to Eat?*\n`;
                text += `📍 *Restaurant:* ${restName}\n`;
                text += `⚙️ *Split Method:* ${this.sessionData.splitMethod === 'proportional' ? 'Proportional by Subtotal' : 'Equal Split'}\n\n`;

                breakdown.participants.forEach(p => {
                    text += `👤 *${p.name}* [${p.isPaid ? 'PAID ✓' : 'UNPAID'}]\n`;
                    p.items.forEach(i => {
                        text += `  • ${i.qty}x ${i.name} (${(i.price * i.qty).toFixed(2)} EGP)\n`;
                    });
                    if (p.note) text += `  📝 Note: ${p.note}\n`;
                    text += `  💰 *Total:* ${p.grandTotal.toFixed(2)} EGP (Sub: ${p.subtotal.toFixed(2)} | Deliv: ${p.deliveryShare.toFixed(2)} | Tax: ${p.taxShare.toFixed(2)})\n\n`;
                });

                text += `-----------------------------------\n`;
                text += `📦 *Items Subtotal:* ${breakdown.groupSubtotal.toFixed(2)} EGP\n`;
                text += `🚗 *Delivery Fee:* ${breakdown.deliveryTotal.toFixed(2)} EGP\n`;
                text += `🧾 *Tax/Service:* ${breakdown.totalTaxEgp.toFixed(2)} EGP\n`;
                text += `💵 *Grand Total Bill:* ${breakdown.grandTotalBill.toFixed(2)} EGP\n`;

                this.fallbackCopyText(text);
            }

            openMenuImageModal() {
                if (this.sessionData.menuImage) {
                    document.getElementById('modal-menu-img-element').src = this.sessionData.menuImage;
                    document.getElementById('modal-menu-image').classList.remove('hidden');
                }
            }

            closeModal(id) {
                document.getElementById(id).classList.add('hidden');
            }

            showToast(message, type = 'info') {
                const container = document.getElementById('toast-container');
                if (!container) return;
                
                const toast = document.createElement('div');
                const bg = type === 'success' ? 'bg-yumara-700' : type === 'error' ? 'bg-rose-800' : 'bg-forest-800';

                toast.className = `pointer-events-auto px-4 py-2.5 rounded-xl shadow-lg font-medium text-xs text-white transition-all transform translate-y-2 opacity-0 ${bg}`;
                toast.innerHTML = `<span>${this.escapeHtml(message)}</span>`;

                container.appendChild(toast);
                setTimeout(() => toast.classList.remove('translate-y-2', 'opacity-0'), 10);
                setTimeout(() => {
                    toast.classList.add('opacity-0', 'translate-y-2');
                    setTimeout(() => toast.remove(), 200);
                }, 3000);
            }

            readFileAsBase64(file) {
                return new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.onload = () => resolve(reader.result);
                    reader.onerror = error => reject(error);
                    reader.readAsDataURL(file);
                });
            }

            escapeHtml(str) {
                if (!str) return '';
                return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }
        }

        window.app = new FoodOrderApp();
    </script>
</body>
</html>
