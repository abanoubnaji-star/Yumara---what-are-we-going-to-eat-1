            async parseAndAddPresets() {
                const rawText = document.getElementById('quick-preset-paste').value;
                const lines = rawText.split('\n');
                const newPresets = [];

                lines.forEach(line => {
                    const parts = line.split('-');
                    if (parts.length >= 2) {
                        const priceStr = parts.pop().trim();
                        const nameStr = parts.join('-').trim();
                        const price = parseFloat(priceStr);

                        if (nameStr && !isNaN(price)) {
                            newPresets.push({
                                id: 'p_' + Math.random().toString(36).substring(2, 6),
                                name: nameStr,
                                price: price
                            });
                        }
                    }
                });

                this.sessionData.presets = newPresets;
                await this.saveSessionData();
                this.closeModal('modal-admin-menu');
                this.showToast('Presets saved!', 'success');
            }

